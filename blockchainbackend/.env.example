# Environment example for the Blockchain Backend (copy to `.env` and fill in your values)
# NOTE: Never commit your `.env` file containing real private keys or secrets to GitHub!

# Server Port
PORT=3000

# Ethereum / RPC Configuration
# Get your RPC URL from Infura (https://infura.io) or Alchemy (https://alchemy.com)
RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# Backend Wallet Private Key (Funded testnet wallet on Sepolia)
# WARNING: Always use a dedicated testnet wallet. Never use a wallet with real mainnet funds!
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Smart Contract Addresses (Deployed on Sepolia / Ganache)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
COMPLAINT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata IPFS Configuration
# Get your API keys from: https://app.pinata.cloud/keys
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here
