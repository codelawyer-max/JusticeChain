# Environment example for the blockchain backend (copy to `.env` and fill values)
# NOTE: Do NOT commit real secrets into source control. Keep `.env` out of git.

# Server
PORT=3000

# Ethereum / RPC
# Example: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
RPC_URL=https://sepolia.infura.io/v3/542f1eaa832d48f7b99c34caca33add7

# Private key of the backend wallet (use a funded testnet account)
PRIVATE_KEY=0xe425cf9d9200b5ed94e7abae0aefdbe805ac43c95c32576d1236ba915a9e3498

# Main deployed JusticeChain contract address (if used)
CONTRACT_ADDRESS=0x0019C4D21966f151d84633BF6347BB4ecEE936EE

# Complaint contract address (optional)
COMPLAINT_CONTRACT_ADDRESS=

# ABI files should be placed in this folder (ComplaintABI.json / JusticeChainABI.json)

# Pinata API keys (if blockchain backend uses Pinata)
PINATA_API_KEY=43871aeceb6a6714608f
PINATA_SECRET_API_KEY=d4f0e5c82eae348ed4c4cd416a13a16b4c5ee7fbeaaecdeefa7d8f8e972280da
PINATA_API_KEY=
PINATA_SECRET_API_KEY=your_pinata_secret_key_here

# Ethereum Wallet Configuration
# Your wallet private key (with funds for gas fees on Sepolia testnet)
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Infura/RPC Configuration
# Get your RPC URL from: https://infura.io or https://www.alchemy.com
RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# Smart Contract Address
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Server Port
PORT=4000
