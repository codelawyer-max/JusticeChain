# Environment example for the Main Backend (copy to `.env` and fill in your values)
# NOTE: Never commit your `.env` file containing real secrets to GitHub!

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Local MongoDB:
MONGO_URL=mongodb://localhost:27017/justicechain
# MongoDB Atlas (Cloud):
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret Key
# Generate a secure random key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production

# Pinata IPFS Configuration (for document & FIR pinning)
# Get your API keys from: https://app.pinata.cloud/keys
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# NFT.Storage API Key (optional fallback for decentralized storage)
NFT_STORAGE_API_KEY=your_nft_storage_api_key_here

# Blockchain Microservice URL
BLOCKCHAIN_BACKEND_URL=http://localhost:3000

# AI Classification Service URL
AI_SERVICE_URL=http://127.0.0.1:5050

# SMTP / Email Notification Configuration (Optional - for citizen notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=no-reply@justicechain.gov.in